# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
TRAKR_SERVICE_URL=http://localhost:3000

# AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# PostgreSQL with pgvector enabled
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trakr

# Optional runtime tuning
RECOMMENDATION_LIMIT=7
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RECOMMENDATION_LOG_RETENTION_DAYS=30
RECOMMENDATION_LOG_HASH_KEY=
TRAKR_SESSION_SECRET=
TRAKR_SESSION_TTL_MINUTES=30

# x402 v2 exact payment on X Layer. Keep enforcement off until the coordinated
# marketplace cutover. The OKX credentials are seller/facilitator API credentials.
TRAKR_X402_ENFORCEMENT=off
TRAKR_X402_PAY_TO=
TRAKR_X402_RESULT_SECRET=
TRAKR_X402_OKX_API_KEY=
TRAKR_X402_OKX_SECRET_KEY=
TRAKR_X402_OKX_PASSPHRASE=
TRAKR_X402_OKX_BASE_URL=https://web3.okx.com

# Optional response-deadline tuning. Defaults are production-safe.
TRAKR_REQUEST_BODY_TIMEOUT_MS=5000
TRAKR_DOCUMENT_PROCESSING_TIMEOUT_MS=8000
TRAKR_BUSINESS_TIMEOUT_MS=25000
TRAKR_AI_ENHANCEMENT_BUDGET_MS=7000
TRAKR_X402_VERIFY_TIMEOUT_MS=8000
TRAKR_X402_SETTLE_TIMEOUT_MS=20000
TRAKR_X402_STATUS_TIMEOUT_MS=5000
TRAKR_DB_CONNECT_TIMEOUT_MS=3000
TRAKR_DB_QUERY_TIMEOUT_MS=5000
TRAKR_DB_STATEMENT_TIMEOUT_MS=5000

# Optional public endpoint guard.
TRAKR_API_KEY=
INGEST_API_KEY=
TRAKR_ADMIN_API_KEY=
